JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Usado sólo por "npm run seed:admin"
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@autos.com
ADMIN_PASSWORD=admin123

PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/mdw-autos
CORS_ORIGIN=http://localhost:5173

# Secretos distintos para cada token (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
